# Copy this file to .env.local for local development.
# NEVER commit a file containing real secrets. .env.local and .env are gitignored.
#
# All values below are placeholders. See docs/IMPLEMENTATION_PLAN.md for the
# reasoning behind each provider choice.

# --- App URLs -----------------------------------------------------------
# Used for building absolute links (emails, redirects, webhooks) and for the
# hostname-based routing middleware introduced in Phase 2.
APP_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Neon Postgres, direct — not Netlify's managed DB product) -
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/mrdrain?sslmode=require"

# --- Auth (custom session layer, introduced in Phase 2) ------------------
# Random 32+ byte secret used to sign/seal session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-generated-random-secret"

# --- Email — Resend, sending subdomain mail.mrdrainsk.com (Phase 14) -----
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="notifications@mail.mrdrainsk.com"

# --- CallRail (Phase 13) --------------------------------------------------
CALLRAIL_API_KEY="replace-with-callrail-api-key"
CALLRAIL_WEBHOOK_SECRET="replace-with-callrail-webhook-shared-secret"

# --- File/photo storage — Cloudflare R2 (Phase 5+) ------------------------
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET_PRIVATE="mrdrain-private"
R2_BUCKET_PUBLIC="mrdrain-public"

# --- Scheduled functions (Phase 12: reminders, backups) -------------------
# Shared secret checked by scheduled/cron-triggered routes so they can't be
# invoked by an arbitrary public request.
CRON_SECRET="replace-with-a-generated-random-secret"
