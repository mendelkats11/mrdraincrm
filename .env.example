# Copy this file to .env.local for local development.
# NEVER commit a file containing real secrets. .env.local and .env are gitignored.
#
# All values below are placeholders.

# --- Site URL -------------------------------------------------------------
# Used to build canonical URLs, the sitemap and structured data. Any leading
# "app." host label is stripped, so the old value still works.
APP_URL="http://localhost:3000"

# --- Contact form email (Resend) -------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="notifications@mail.example.com"
# Comma-separated recipients for contact-form submissions. Required: without
# it the form returns an error instead of silently dropping the lead.
LEAD_NOTIFICATION_EMAILS="owner@example.com"

# --- Photo storage (Cloudflare R2) -----------------------------------------
# Site photos live under the "public-assets/" prefix and are served through
# /api/public-assets/ (see src/lib/storage/public-asset-handler.ts).
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET_PRIVATE="your-bucket-name"
